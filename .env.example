# Docker PostgreSQL settings. Copy this file to .env on the Edge device.
# Use a long unique password; .env is ignored by Git.
VISION_OFFICE_POSTGRES_DB=vision_office
VISION_OFFICE_POSTGRES_USER=vision_office
VISION_OFFICE_POSTGRES_PASSWORD=replace-with-a-long-local-password

# Optional read-only EduSchool directory synchronization.
EDUSCHOOL_EXTERNAL_BEARER_TOKEN=
EDUSCHOOL_EXTERNAL_API_KEY=
